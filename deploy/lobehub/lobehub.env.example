COMPOSE_PROJECT_NAME=lobehub
LOBE_IMAGE=lobehub:newapi-v2.2.20-local
LOBE_PUBLIC_URL=https://chat.example.com
NEW_API_PUBLIC_URL=https://api.example.com
NEW_API_INTERNAL_URL=https://api.example.com
S3_ENDPOINT=https://files.example.com

# Generate independent random values. Keep them outside Git and preserve them on upgrades.
# Match New API's Web Chat settings secret (LOBE_BRIDGE_SECRET is its environment fallback).
NEW_API_CHAT_BRIDGE_SECRET=
POSTGRES_PASSWORD=
AUTH_SECRET=
# Exactly 32 random bytes encoded as Base64 for the AES-256 key vault.
KEY_VAULTS_SECRET=
S3_ACCESS_KEY_ID=lobehub
S3_SECRET_ACCESS_KEY=
